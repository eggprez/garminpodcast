# Copy to .env and fill in. Never commit the real .env.

# Web UI login.
PODCAST_ADMIN_USER=admin
PODCAST_ADMIN_PASSWORD=change-me

# Signs the session cookie. Generate with: openssl rand -hex 32
# If unset, a random key is created at boot and every restart logs you out.
PODCAST_SECRET_KEY=

# Public HTTPS address, shown on the watch-setup page.
PODCAST_BASE_URL=https://podcasts.example.com
# Set true once you only reach the server over HTTPS. Leaving it false while
# testing over plain http keeps login working.
PODCAST_COOKIE_SECURE=false

# How long the server keeps audio on disk. The watch separately deletes its own
# copies after 2 days.
PODCAST_RETENTION_DAYS=14
PODCAST_EPISODES_PER_FEED=5
PODCAST_REFRESH_MINUTES=60

# auto  = re-encode only when the source is not already an acceptable MP3
# always = re-encode everything
# never  = only strip metadata/artwork, never re-encode
PODCAST_TRANSCODE_MODE=auto
PODCAST_MAX_BITRATE_KBPS=128
PODCAST_TARGET_BITRATE_KBPS=64
