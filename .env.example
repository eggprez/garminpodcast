# OPTIONAL. The server runs with no .env file at all — every value below
# already has a working default. Copy this to .env only if you want to change
# something.
#
# The one setting worth changing before exposing the server to the internet is
# PODCAST_ADMIN_PASSWORD.

# Web UI login. Default: admin / changeme
PODCAST_ADMIN_USER=admin
PODCAST_ADMIN_PASSWORD=changeme

# Public HTTPS address, shown on the watch-setup page. Default: empty, in which
# case that page falls back to whatever address you browsed in on.
PODCAST_BASE_URL=https://podcasts.example.com

# Set true once you only reach the server over HTTPS. Leaving it false keeps
# login working while you test over plain http. Default: false
PODCAST_COOKIE_SECURE=false

# How long the server keeps audio on disk. The watch separately deletes its own
# copies after 2 days. Defaults: 14 / 5 / 15
#
# PODCAST_REFRESH_MINUTES only sets the starting value -- the poll interval is
# editable in the web UI under Settings, and that choice wins from then on.
PODCAST_RETENTION_DAYS=14
PODCAST_EPISODES_PER_FEED=5
PODCAST_REFRESH_MINUTES=15

# auto   = re-encode only when the source is not already an acceptable MP3
# always = re-encode everything
# never  = only strip metadata/artwork, never re-encode
# Defaults: auto / 128 / 64
PODCAST_TRANSCODE_MODE=auto
PODCAST_MAX_BITRATE_KBPS=128
PODCAST_TARGET_BITRATE_KBPS=64

# Not listed here on purpose: PODCAST_SECRET_KEY. It is generated on first boot
# and persisted to /data/secret.key, so sessions survive restarts with no setup.
# Set it explicitly only if you run multiple replicas sharing one login.
