<?xml version="1.0" encoding="utf-8"?>
<!--
  These are edited in Garmin Connect Mobile:
  Devices > (watch) > Connect IQ Apps > Podcasts > Settings.
  Entering them on the phone avoids typing a long token on the watch.
-->
<settings>
    <setting propertyKey="@Properties.serverUrl" title="@Strings.SettingServerUrl">
        <settingConfig type="alphaNumeric" maxLength="120"/>
    </setting>

    <setting propertyKey="@Properties.apiToken" title="@Strings.SettingApiToken">
        <settingConfig type="alphaNumeric" maxLength="120"/>
    </setting>

    <setting propertyKey="@Properties.episodeLimit" title="@Strings.SettingEpisodeLimit">
        <settingConfig type="numeric" min="1" max="50"/>
    </setting>
</settings>
